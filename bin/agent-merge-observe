#!/usr/bin/env bash
# Observe opt-in auto-merge candidates without merging anything.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  echo "usage: agent-merge-observe"
  echo "writes JSONL observations to \$AUTO_MERGE_OBSERVE_LOG or ~/.cache/agent-workflow/"
  exit 0
fi

# shellcheck source=../cross-review/config.sh
source "$here/cross-review/config.sh"

log_file="${AUTO_MERGE_OBSERVE_LOG:-$HOME/.cache/agent-workflow/auto-merge-observe.jsonl}"
log_dir="$(dirname "$log_file")"
if [[ ! -d "$log_dir" ]]; then
  mkdir -p -m 700 "$log_dir"
fi
touch "$log_file"
chmod 600 "$log_file"
lock_file="${AUTO_MERGE_OBSERVE_LOCK:-$log_dir/auto-merge-observe.lock}"
exec 9>"$lock_file"
flock -n 9 || exit 0
chmod 600 "$lock_file"
failures=0

append_record() {
  local repo_name="$1" gh_repo="$2" pr_number="$3" exit_code="$4" kind="$5" output="$6"
  OBSERVED_OUTPUT="$output" python3 - "$log_file" "$repo_name" "$gh_repo" "$pr_number" "$exit_code" "$kind" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone

log_file, repo_name, gh_repo, pr_number, exit_code, kind = sys.argv[1:]
record = {
    "observed_at": datetime.now(timezone.utc).isoformat(),
    "repo": repo_name,
    "github_repo": gh_repo,
    "pr": int(pr_number),
    "exit_code": int(exit_code),
    "kind": kind,
    "output": os.environ.get("OBSERVED_OUTPUT", "").rstrip(),
}
with open(log_file, "a", encoding="utf-8") as stream:
    stream.write(json.dumps(record, ensure_ascii=False) + "\n")
PY
}

for entry in "${REPOS[@]}"; do
  IFS='|' read -r repo_name gh_repo _src _worktree <<<"$entry"
  list_error_file="$(mktemp)"
  set +e
  pr_numbers="$(gh pr list -R "$gh_repo" --state open --label automation:auto-merge --limit 1000 \
    --json number --jq '.[].number' 2>"$list_error_file")"
  list_exit=$?
  set -e
  list_error="$(<"$list_error_file")"
  rm -f "$list_error_file"
  if [[ $list_exit -ne 0 ]]; then
    append_record "$repo_name" "$gh_repo" "0" "$list_exit" "list_error" "$list_error"
    failures=$((failures + 1))
    continue
  fi
  while IFS= read -r pr_number; do
    [[ -n "$pr_number" ]] || continue
    [[ "$pr_number" =~ ^[0-9]+$ ]] || continue
    set +e
    output="$("$here/bin/agent-merge-gate" --repo="$repo_name" --pr="$pr_number" 2>&1)"
    gate_exit=$?
    set -e
    gate_kind="gate"
    if [[ $gate_exit -ne 0 && $gate_exit -ne 2 ]]; then
      gate_kind="gate_error"
    fi
    append_record "$repo_name" "$gh_repo" "$pr_number" "$gate_exit" "$gate_kind" "$output"
    if [[ $gate_exit -ne 0 && $gate_exit -ne 2 ]]; then
      failures=$((failures + 1))
    fi
  done <<<"$pr_numbers"
done

if (( failures > 0 )); then
  exit 1
fi
